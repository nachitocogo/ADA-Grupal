{
  "name": "ada-grupal",
  "private": true,
  "version": "1.0.0",
  "description": "ADA Grupal — preguntas de los alumnos para la clase grupal semanal de la Academia de Arbitraje",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3010",
    "build": "tsc --noEmit && vite build",
